Vagrant.require_version ">= 2.2.0"
Vagrant.configure("2") do |config|
  config.vm.box = "debian/trixie64"
  config.vm.box_version = "13.20260519.1"
  config.env.enable

  # Values imposed by the subject; .env can override them, but they work out of the box.
  server_name = ENV.fetch("SERVER_NAME", "hkeromneS")
  server_ip   = ENV.fetch("SERVER_IP",   "192.168.56.110")
  agent_name  = ENV.fetch("AGENT_NAME",  "hkeromneSW")
  agent_ip    = ENV.fetch("AGENT_IP",    "192.168.56.111")
  k3s_url     = "https://#{server_ip}:6443"
  k3s_token   = ENV["K3S_TOKEN"]

  raise "K3S_TOKEN is not set (cp .env.example .env and fill it in)" if k3s_token.to_s.empty?

  config.vm.provider "libvirt" do |kvm|
    kvm.cpus = 1
    kvm.memory = 512
  end

  config.vm.define server_name do |server|
    server.vm.hostname = server_name
    server.vm.network "private_network", ip: server_ip
    server.vm.provision "shell", path: "scripts/server.sh", env: { "K3S_TOKEN" => k3s_token,
                                                                   "SERVER_IP" => server_ip }
  end

  config.vm.define agent_name do |agent|
    agent.vm.hostname = agent_name
    agent.vm.network "private_network", ip: agent_ip
    agent.vm.provision "shell", path: "scripts/agent.sh", env: { "K3S_TOKEN" => k3s_token,
                                                                 "K3S_URL"   => k3s_url,
                                                                 "AGENT_IP"  => agent_ip }
  end
end
