Vagrant.require_version ">= 2.2.0"
Vagrant.configure("2") do |config|
  config.vm.box = "generic/debian12"
  config.vm.box_version = "4.3.12"
  config.env.enable

  required = %w[
  SERVER_NAME SERVER_IP
  AGENT_NAME AGENT_IP
  K3S_TOKEN K3S_URL
  ]

  required.each do |var|
    raise "#{var} is not set" unless ENV[var]
  end

  config.vm.provider "libvirt" do |kvm|
    kvm.cpus = 1
    kvm.memory = 512
  end

  config.vm.define ENV["SERVER_NAME"] do |server|
    server.vm.hostname = ENV["SERVER_NAME"]
    server.vm.network "private_network", ip: ENV["SERVER_IP"]
    server.vm.provision "shell", path: "script/server.sh", env: { "K3S_TOKEN" => ENV["K3S_TOKEN"],
                                                                  "SERVER_IP"  => ENV["SERVER_IP"] }
  end

  config.vm.define ENV["AGENT_NAME"] do |agent|
    agent.vm.hostname = ENV["AGENT_NAME"]
    agent.vm.network "private_network", ip: ENV["AGENT_IP"]
    agent.vm.provision "shell", path: "script/agent.sh", env: { "K3S_TOKEN" =>  ENV["K3S_TOKEN"],
                                                                "K3S_URL"   =>  ENV["K3S_URL"],
                                                                "AGENT_IP" =>  ENV["AGENT_IP"] }
  end
end
