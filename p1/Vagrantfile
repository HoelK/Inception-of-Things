Vagrant.require_version ">= 2.4.9"
Vagrant.configure("2") do |config|
  config.vm.box = "generic/debian12"
  config.vm.box_version = "4.3.12"
  
  config.vm.provider "libvirt" do |kvm|
    kvm.cpus = 1
    kvm.memory = 512
  end

  $script = <<-SCRIPT
  sudo apt update && sudo apt install curl -y
  curl -sfL https://get.k3s.io | sh -
  SCRIPT

  config.vm.define "sbonneauS" do |server|
    server.vm.hostname = "sbonneauS"
    server.vm.network "private_network", ip: "192.168.56.110"
    server.vm.provision "shell", inline: $script
  end

  config.vm.define "hkeromneSW" do |agent|
    agent.vm.hostname = "hkeromneSW"
    agent.vm.network "private_network", ip: "192.168.56.111"
    agent.vm.provision "shell", inline: $script
  end
end
